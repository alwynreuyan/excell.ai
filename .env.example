# Excell AI Backend Configuration

# Get your API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_api_key_here

# Optional: Change the model (default: gemini-1.5-flash)
GEMINI_MODEL=gemini-1.5-flash

# Optional: Server port (default: 3001)
PORT=3001

# Optional: Environment (development or production)
NODE_ENV=development

# Optional: Allowed origins for CORS (comma-separated)
ALLOWED_ORIGINS=http://localhost:8000,http://localhost:5500,http://localhost:3000,http://localhost:3001

# 🔐 IMPORTANT: Authentication token for API access
# Generate a secure token: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# In production, always set this to a secure random value
AUTH_TOKEN=your_secure_auth_token_here
